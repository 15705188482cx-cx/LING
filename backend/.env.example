# ling 后端环境变量
# 用法：复制本文件为 .env 并填入实际值
# cp .env.example .env

# ============================================================
# 必填
# ============================================================

# LLM API 密钥（OpenAI 兼容接口，如 MiniMax / OpenAI / DeepSeek）
LLM_API_KEY=你的API密钥

# LLM 服务地址
LLM_BASE_URL=https://api.minimaxi.com/v1

# LLM 模型名
LLM_MODEL=MiniMax-M3

# ============================================================
# 可选 - 服务端口
# ============================================================

# 后端 HTTP 服务端口（默认 8765）
PORT=8765

# WebSocket 语音通话端口（默认 8766）
WS_PORT=8766

# ============================================================
# 可选 - TTS 语音合成（GPT-SoVITS）
# ============================================================

# GPT-SoVITS mini_tts_server 地址（独立进程，默认 :8880）
LIUJIALING_URL=http://127.0.0.1:8880/v1/audio/speech

# GPT-SoVITS 流式合成地址（空=禁用流式，走 LIUJIALING_URL 整句合成）
TTS_STREAMING_URL=http://127.0.0.1:9880/tts

# 流式 TTS 模式：0=非流式 1=旧版分段(质量最佳) 2=真流式 3=定长分块
TTS_STREAMING_MODE=1

# TTS 参考音频（默认用 backend/assets/ref_liu.wav）
# TTS_REF_AUDIO=/path/to/ref.wav

# GPT-SoVITS 引擎目录（tts_server.py 启动用，约 26GB，不入仓库）
# GPT_SOVITS_DIR=G:/path/to/GPT-SoVITS

# GPT/SoVITS 模型权重路径（相对 GPT_SOVITS_DIR 或绝对路径）
# TTS_GPT_PATH=GPT_SoVITS/GPT_weights_v2Pro/liujialing-e6.ckpt
# TTS_SOVITS_PATH=GPT_SoVITS/SoVITS_weights_v2Pro/liujialing_e12_s600.pth

# ============================================================
# 可选 - ASR 语音识别（FunASR SenseVoiceSmall）
# ============================================================

# SenseVoiceSmall 模型目录（约 894MB，不入仓库）
# 下载：https://github.com/FunAudioLLM/SenseVoice
# 不配置则 ASR 禁用，语音通话不可用但文字聊天正常
# ASR_MODEL_DIR=/path/to/SenseVoiceSmall

# 流式 ASR 模型目录（sherpa-onnx，当前未启用，预留）
# STREAMING_ASR_MODEL_DIR=/path/to/sherpa-onnx-streaming-zipformer-zh-14M-2023-02-23

# ============================================================
# 可选 - VAD 语音活动检测（SileroVAD）
# ============================================================

# silero_vad.onnx 模型路径（默认从 silero-vad pip 包自动定位）
# pip install silero-vad 后无需配置；如需指定：
# VAD_MODEL_PATH=/path/to/silero_vad.onnx

# VAD 参数
VAD_THRESHOLD=0.5
VAD_THRESHOLD_LOW=0.2
VAD_SILENCE_MS=600

# ============================================================
# 可选 - 记忆检索（FAISS + sentence-transformers）
# ============================================================

# HuggingFace 模型缓存目录（bge-small-zh-v1.5 首次下载用）
# 默认 E:/Hermes/hf_cache，按需修改
# HF_HOME=/path/to/hf_cache

# 人格文件路径（默认 backend/assets/SKILL_CORE.md）
# SKILL_CORE_PATH=/path/to/SKILL_CORE.md

# ============================================================
# 可选 - VLM 视觉模型
# ============================================================

# 复用 LLM 凭证，仅模型名可覆盖
VLM_MODEL=MiniMax-M3
